# ==============================================================================
# Faculty360 Environment Configuration
# Target Architecture: React -> Express -> Supabase -> PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (Browser-accessible via Vite)
# ------------------------------------------------------------------------------
# The Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# The Supabase Public / Publishable Anon Key (Safe for browser distribution)
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT CONFIGURATION (Server-only secrets: NEVER expose to browser)
# ------------------------------------------------------------------------------
# The Supabase Project URL or API gateway for server-side operations
SUPABASE_URL="https://your-project.supabase.co"

# The Supabase Service Role Key (Bypasses RLS, used exclusively on Express server)
# CRITICAL: Keep this strictly secret. Never prefix with VITE_ or send to frontend.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# The direct or pooled PostgreSQL database connection string provided by Supabase
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. OPTIONAL / PLATFORM ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for AI-assisted schedule optimization and insights.
# Injected automatically by the AI Studio platform runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The base URL where this applet is hosted (e.g., Cloud Run public URL).
APP_URL=""


